generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id            String    @id
  email         String    @unique(map: "User_email_key")
  password      String
  emailVerified DateTime?
  image         String?
  name          String?
  role          String?   @db.VarChar(50)
  perfiles      perfil[]
}

model perfil_documentos {
  id             Int       @id @default(autoincrement())
  perfil_id      Int
  tipo           String    @db.VarChar(40)
  nombre_archivo String    @db.VarChar(255)
  mime_type      String    @db.VarChar(120)
  tamano         Int
  contenido      Bytes
  creado_en      DateTime? @default(now()) @db.Timestamp(0)
  perfil         perfil    @relation(fields: [perfil_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_perfil")

  @@index([perfil_id], map: "fk_perfil")
}

model perfil {
  id                Int                 @id @default(autoincrement())
  nombres           String              @db.VarChar(120)
  apellidos         String              @db.VarChar(120)
  cedula            String              @db.VarChar(40)
  correo            String              @db.VarChar(160)
  telefono          String              @db.VarChar(40)
  fecha_nacimiento  String?             @db.VarChar(20)
  genero            String?             @db.VarChar(40)
  direccion         String              @db.VarChar(255)
  carrera           String              @db.VarChar(160)
  semestre          String?             @db.VarChar(10)
  creado_en         DateTime?           @default(now()) @db.Timestamp(0)
  id_user           String?
  perfil_documentos perfil_documentos[]
  user              user?               @relation(fields: [id_user], references: [id], onDelete: Cascade, map: "FK_perfiles_user")
  solicitudes       solicitudes[]

  @@index([id_user], map: "FK_perfiles_user")
  @@map("perfiles")
}

model solicitudes {
  id                  Int                  @id @default(autoincrement())
  id_perfil           Int?
  carrera             String?              @db.VarChar(50)
  comentarios         String?              @db.Text
  estatus             solicitudes_estatus? @default(pendiente)
  fecha_actualizacion DateTime?            @default(now()) @db.Timestamp(0)
  fecha_creacion      DateTime?            @default(now()) @db.Timestamp(0)
  perfiles            perfil?              @relation(fields: [id_perfil], references: [id], onDelete: Cascade, map: "solicitudes_ibfk_1")

  @@index([id_perfil], map: "id_perfil")
}

enum solicitudes_estatus {
  aprobado
  rechazado
  pendiente
}
